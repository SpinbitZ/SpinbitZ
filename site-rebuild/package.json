    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "babel-loader": "^9.1.3",
    "callbag-basics": "^3.2.0",
    "callbag-jsx": "^0.1.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.2.5",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4"
